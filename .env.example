# Скопируйте этот файл в .env и впишите свои значения:
#   cp .env.example .env
# Файл .env в .gitignore и НЕ попадёт в репозиторий.

# Пароль пользователя PostgreSQL (используется и базой, и приложением).
# Сгенерировать сильный пароль:  openssl rand -hex 24
DB_PASSWORD=change-me-to-a-strong-password

# Стратегия схемы Hibernate: update (создаёт/обновляет схему сам) или validate.
# На зрелом проде — validate + миграции (Flyway/Liquibase).
JPA_DDL_AUTO=update

# --- Отправка писем (код для сброса пароля) ---
# MAIL_ENABLED=false — код сброса НЕ шлётся по почте, а пишется в лог приложения.
# Поставьте true и заполните SMTP_* ниже, чтобы письма реально отправлялись.
MAIL_ENABLED=false
# Адрес отправителя. Должен совпадать с доменом/ящиком, от которого разрешено слать
# (иначе письма уйдут в спам). Часто = SMTP_USERNAME.
MAIL_FROM=no-reply@example.com
# Параметры SMTP-сервера вашего почтового провайдера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
